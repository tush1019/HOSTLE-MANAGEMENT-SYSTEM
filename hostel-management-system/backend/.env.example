# ============================================================
# HostelHub Backend — copy this file to ".env" and fill values
# NEVER commit the real .env with secrets to git.
# ============================================================

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hostel_management

# ------------------------------------------------------------
# OPTION 1 (recommended): EmailJS HTTPS API — port 443 only.
# Works on networks where SMTP ports (25/465/587) are blocked.
# 1. Sign up free at https://www.emailjs.com  (200 emails/month)
# 2. Add a Service (e.g. Gmail) → copy Service ID
# 3. Create a Template → copy Template ID
# 4. Account → copy Public Key
# 5. Fill the 3 values below — they take priority over SMTP.
EMAILJS_SERVICE_ID=service_a3u2ceu
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_ACCESS_TOKEN=

# ------------------------------------------------------------
# OPTION 2 (fallback): Gmail SMTP — needs open SMTP ports.
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. NEVER put your real Gmail login password here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youremail@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password-here
EMAIL_FROM=youremail@gmail.com
